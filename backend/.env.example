# Local demo defaults. Copy to .env; never commit .env or live credentials.
APP_ENV=development
# Blank uses a random process-local development key; reload/restart invalidates tokens.
# Generate a stable key with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Non-development environments require a strong stable SECRET_KEY (32+ characters).
SECRET_KEY=
DATABASE_URL=sqlite:///./aipulse.db
AI_MODE=mock
AI_MOCK_SCENARIO=valid
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
LLM_API_URL=
LLM_API_KEY=
LLM_MODEL=
